<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- kuma3 Anki's provider (and plain AnkiDroid's, as a fallback) -->
    <uses-permission android:name="io.github.pedrubik2000.kuma3.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="com.ichi2.anki.debug.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />
    <!-- buzz on answers and combo breaks -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- card images, audio and video from collection.media; music, wallpaper and Hunger's sprites from Music/Pictures -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <queries>
        <provider android:authorities="io.github.pedrubik2000.kuma3.flashcards" />
        <provider android:authorities="com.ichi2.anki.debug.flashcards" />
        <provider android:authorities="com.ichi2.anki.flashcards" />
        <package android:name="io.github.pedrubik2000.kuma3" />
        <package android:name="com.ichi2.anki.debug" />
        <package android:name="com.ichi2.anki" />
        <package android:name="io.github.pedrubik2000.kumapie.mobile" />
        <!-- Anki XP's start menu, All Programs (the app can be the home screen) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="kuma3 Skins"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- pick kuma3 Skins as the home app: with the XP skin, its desktop, taskbar and start menu become the device's -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
